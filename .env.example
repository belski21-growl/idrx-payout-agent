# Copy to .env (NEVER commit .env) — or export the vars in your shell.
# The agent reads the wallet key ONLY from the environment.
CELO_WORK_KEY=
# Optional: Celo RPC endpoint (default https://forno.celo.org)
# CELO_RPC_URL=
# Optional: attribution code issued by Loops House at enrollment.
# If set, the agent tags with BOTH this code and the repo-derived code.
# LOOPS_ATTRIBUTION_CODE=
# Optional: Textile partner API key. When set, no takerProof signature is needed.
# TEXTILE_API_KEY=
